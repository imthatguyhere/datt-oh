# datt-oh environment configuration
# Copy this file to `.env` and adjust as needed.
# Mode: ui | silent
MODE=ui

# Config source (local file path or http(s) URL).
# Leave commented out to use the automatic default (../config.json, then ./config.json).
# CONFIG=../config.json

# Optional overrides (uncomment as needed):
# PLATFORM=concord
# INSTALLER_URL=https://concord.rmm.datto.com/download-agent/windows/<site-uid>
# SAVE_PATH=C:\ProgramData\datt-oh\DattoAgent\AgentSetup.exe
# SITE=77FORT
# SITE_UID=00000000-0000-0000-0000-000000000001
# LOG_PATH=C:\ProgramData\datt-oh\logs\installer.log

# Sites generator (`npm run sites`), developer tool only. Datto RMM API keys:
# Setup > Users > (your user) > API Access.
# Leave unset to be asked in the terminal.
# DATTO_API_KEY=
# DATTO_API_SECRET=
# SITES_OUT=sites.json
